# Production Compose configuration on the deployment server.
# Copy to .env in ALIYUN_APP_DIR. Keep actual values out of Git.
DB_USER=resume
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=resume_copilot
# URL-encode the database password here, using the same password as DB_PASSWORD.
# The hostname must be the Compose service postgres.
DATABASE_URL=postgresql://resume:replace-with-a-strong-password@postgres:5432/resume_copilot
BETTER_AUTH_URL=https://resume.example.com
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
LOG_LEVEL=info
# ALIYUN_REGISTRY and IMAGE_TAG are supplied by the deployment workflow.
