{
  "name": "resume-copilot",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' --filter './packages/*' --if-present run dev",
    "dev:web": "pnpm --filter @resume-copilot/web dev",
    "dev:api": "pnpm --filter @resume-copilot/api dev",
    "db:generate": "pnpm --filter @resume-copilot/api run db:generate",
    "db:migrate": "pnpm --filter @resume-copilot/api run db:migrate",
    "db:push": "pnpm --filter @resume-copilot/api run db:push",
    "db:studio": "pnpm --filter @resume-copilot/api run db:studio",
    "build": "pnpm -r --if-present run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "test:e2e": "pnpm --filter @resume-copilot/web test:e2e"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3"
  }
}
