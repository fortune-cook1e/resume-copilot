{
  "name": "resume-copilot",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' --filter './packages/*' --if-present run dev",
    "dev:web": "pnpm --filter @resume-copilot/web dev",
    "dev:api": "pnpm --filter @resume-copilot/api dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm lint:root && pnpm -r --if-present run lint",
    "lint:root": "eslint eslint.config.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @resume-copilot/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
