{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resume-copilot",
  "main": "worker.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "API",
      "service": "resume-copilot-api",
    },
  ],
  "env": {
    "test": {
      "name": "resume-copilot-test",
      "workers_dev": true,
      "preview_urls": false,
      "services": [
        {
          "binding": "API",
          "service": "resume-copilot-api-test",
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
  },
}
