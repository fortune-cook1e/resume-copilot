# Web-only local configuration. Never put database credentials or auth secrets here.
# Web origin used for same-origin request validation.
BETTER_AUTH_URL=http://localhost:3000
# Trusted NestJS origin; required when building Web rewrites and at runtime.
API_INTERNAL_URL=http://127.0.0.1:3001
# In production, use the public HTTPS Web origin and a reachable internal API origin.

# Next.js configuration.
NODE_ENV=development
PORT=3000
