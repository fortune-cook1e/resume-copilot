{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "Node20",
    "moduleResolution": "Node16",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "vitest.config.mts", "vitest.setup.mts"],
  "exclude": ["node_modules", "dist"]
}
