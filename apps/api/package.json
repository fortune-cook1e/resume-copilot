{
  "name": "@resume-copilot/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm --filter @resume-copilot/contracts build && nest start --watch",
    "build": "pnpm --filter @resume-copilot/contracts build && nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @resume-copilot/contracts build && tsc --noEmit -p tsconfig.build.json",
    "test": "pnpm build && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@resume-copilot/contracts": "workspace:*",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5",
    "@types/node": "^22.0.0",
    "vitest": "^4.1.2"
  }
}
