{
  "name": "@resume-copilot/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "build": "pnpm --filter @resume-copilot/contracts build && nest build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "lint": "oxlint .",
    "typecheck": "pnpm build && tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "pnpm build:worker && tsc --noEmit && vitest run",
    "build:worker": "wrangler deploy --dry-run --outdir .worker-test",
    "deploy": "wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@resume-copilot/contracts": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5",
    "@types/node": "^22.0.0",
    "drizzle-kit": "0.31.9",
    "miniflare": "5.20261104.0-beta",
    "vitest": "^4.1.2",
    "wrangler": "^4.158.0"
  }
}
