{
  "name": "@resume-copilot/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm --filter @resume-copilot/contracts build && nest start --watch",
    "build": "pnpm --filter @resume-copilot/contracts build && nest build",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint .",
    "typecheck": "pnpm --filter @resume-copilot/contracts build && tsc --noEmit -p tsconfig.build.json",
    "test": "pnpm build && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@resume-copilot/contracts": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "3.4.8",
    "puppeteer-core": "24.36.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5",
    "@types/node": "^22.0.0",
    "drizzle-kit": "0.31.9",
    "vitest": "^4.1.2"
  }
}
