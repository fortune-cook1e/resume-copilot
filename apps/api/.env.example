# Development only: copy to apps/api/.env. Never commit real secrets.
# Production/test ignore this file and use injected process environment variables.
NODE_ENV=development
HOST=0.0.0.0
# Optional MCP local-only trial after approved database migrations: set MCP_ENABLED=true
# and HOST=127.0.0.1 together. Never enable this trial in production.
MCP_ENABLED=false
PORT=3001
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=1048576
# Local Compose database: resume_copilot on 127.0.0.1:5432 (see docker-compose.yml).
# In the ignored apps/api/.env, replace the placeholder with your local POSTGRES_PASSWORD.
# Never put a working password in this tracked example; tests use resume_copilot_test.
DATABASE_URL=postgresql://resume:YOUR_LOCAL_POSTGRES_PASSWORD@127.0.0.1:5432/resume_copilot
# Google Console callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Generate a unique secret of at least 32 random bytes. Do not reuse the Google secret.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
BETTER_AUTH_URL=http://localhost:3000
